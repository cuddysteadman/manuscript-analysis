# Local AWS deployment identifiers. Copy to deploy.local.env.
# AWS credentials belong in the standard AWS credential chain, not this file.
AWS_REGION=
AWS_ACCOUNT_ID=
AWS_S3_BUCKET=
MANUSCRIPT_INPUT_PREFIX=files
AWS_BATCH_JOB_QUEUE=
AWS_ECR_REPOSITORY=
AWS_CODEBUILD_PROJECT=
