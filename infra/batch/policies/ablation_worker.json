{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/files/*",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/files/null_results/*",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/results/matched-ablation/*"
      ]
    }
  ]
}
