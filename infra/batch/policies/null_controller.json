{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectAndReviseNullBatchJobs",
      "Effect": "Allow",
      "Action": [
        "batch:DescribeJobDefinitions",
        "batch:DescribeJobQueues",
        "batch:ListJobs",
        "batch:RegisterJobDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SubmitOnlyNullLstmJobs",
      "Effect": "Allow",
      "Action": "batch:SubmitJob",
      "Resource": [
        "arn:aws:batch:eu-west-1:518385901091:job-queue/null-lstm-gpu-spot",
        "arn:aws:batch:eu-west-1:518385901091:job-definition/null-lstm-worker:*"
      ]
    },
    {
      "Sid": "InspectNullWorkerRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:DescribeRepositories"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BuildNullWorkerRevision",
      "Effect": "Allow",
      "Action": [
        "codebuild:BatchGetBuilds",
        "codebuild:StartBuild"
      ],
      "Resource": "arn:aws:codebuild:eu-west-1:518385901091:project/null-lstm-worker-build"
    },
    {
      "Sid": "ListOnlyNullV3Shards",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sagemaker-eu-west-1-518385901091",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "results/null-distribution/shards/corrected-null-v3/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadNullInputsAndControllerState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/files/training_config.json",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/files/unsorted/*",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/files/sorted/*",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/files/pruned/*",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/results/null-distribution/control/*",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/results/null-distribution/shards/corrected-null-v3/*"
      ]
    },
    {
      "Sid": "WriteNullBuildStateAndResults",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/results/null-distribution/control/*",
        "arn:aws:s3:::sagemaker-eu-west-1-518385901091/results/null-distribution/final/corrected-null-v3/*"
      ]
    }
  ]
}
